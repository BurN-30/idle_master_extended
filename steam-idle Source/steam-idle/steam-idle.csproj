<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>steam_idle</RootNamespace>
    <AssemblyName>steam-idle</AssemblyName>
    <ApplicationIcon>logo1.ico</ApplicationIcon>
    <LangVersion>7.3</LangVersion>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Keep AssemblyInfo.cs as the single source of assembly attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!-- Output straight into bin\<Config>\ (no net48 subfolder), like the original. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Steamworks.NET">
      <HintPath>..\..\Dependencies\Steamworks.NET.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Was a PostBuildEvent: copy the native Steam API next to the executable. -->
  <Target Name="CopySteamApi" AfterTargets="Build">
    <Copy SourceFiles="..\..\Dependencies\steam_api64.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
