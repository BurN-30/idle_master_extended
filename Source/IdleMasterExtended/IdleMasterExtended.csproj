<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>IdleMasterExtended</RootNamespace>
    <AssemblyName>IdleMasterExtended</AssemblyName>
    <ApplicationIcon>logo1.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>IdleMasterExtended.Program</StartupObject>
    <LangVersion>7.3</LangVersion>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Keep AssemblyInfo.cs as the single source of assembly attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!-- Output straight into bin\<Config>\ (no net48 subfolder), like the original. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.11.42" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Steamworks.NET">
      <HintPath>..\..\Dependencies\Steamworks.NET.dll</HintPath>
    </Reference>
    <Reference Include="System.Management" />
    <Reference Include="System.Deployment" />
  </ItemGroup>

  <!-- Build steam-idle first (build order only, its assembly is not referenced). -->
  <ItemGroup>
    <ProjectReference Include="..\..\steam-idle Source\steam-idle\steam-idle.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- Was a PostBuildEvent: pull in steam-idle.exe and the native Steam API so the app can
       launch the idler. steam-idle.exe.config is required too: it carries the binding
       redirect for System.Resources.Extensions, without it the helper dies on startup
       (FileLoadException) and no game is ever idled. Satellite language folders are left
       in their standard per-culture directories (the .NET runtime resolves them there). -->
  <Target Name="CopyRuntimeDeps" AfterTargets="Build">
    <Copy SourceFiles="..\..\steam-idle Source\steam-idle\bin\$(Configuration)\steam-idle.exe;..\..\steam-idle Source\steam-idle\bin\$(Configuration)\steam-idle.exe.config"
          DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="..\..\Dependencies\steam_api64.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
