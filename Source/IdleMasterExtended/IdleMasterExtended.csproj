<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>IdleMasterExtended</RootNamespace>
    <AssemblyName>IdleMasterExtended</AssemblyName>
    <ApplicationIcon>logo1.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>IdleMasterExtended.Program</StartupObject>
    <LangVersion>7.3</LangVersion>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- Keep AssemblyInfo.cs as the single source of assembly attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!-- Output straight into bin\<Config>\ (no net48 subfolder), like the original. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.11.42" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Steamworks.NET">
      <HintPath>..\..\Dependencies\Steamworks.NET.dll</HintPath>
    </Reference>
    <Reference Include="System.Management" />
    <Reference Include="System.Deployment" />
  </ItemGroup>

  <!-- Was a PostBuildEvent: pull in steam-idle.exe (built separately) and the native
       Steam API so the app can launch the idler. Satellite language folders are left
       in their standard per-culture directories (the .NET runtime resolves them there). -->
  <Target Name="CopyRuntimeDeps" AfterTargets="Build">
    <Copy SourceFiles="..\..\steam-idle Source\steam-idle\bin\$(Configuration)\steam-idle.exe"
          DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true"
          Condition="Exists('..\..\steam-idle Source\steam-idle\bin\$(Configuration)\steam-idle.exe')" />
    <Copy SourceFiles="..\..\Dependencies\steam_api64.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
